
import React from 'react';

interface BadgeProps {
  children: React.ReactNode;
  /**
   * Color theme for the badge.
   * Matches common Tailwind color names.
   */
  color?: string;
  className?: string;
  onClick?: () => void;
}

export const Badge: React.FC<BadgeProps> = ({
  children,
  color = 'neutral',
  className = '',
  onClick
}) => {
  // Predefined style mapping for common colors to avoid dynamic class issues with Tailwind
  const colorMap: Record<string, string> = {
    green: 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 border-green-200 dark:border-green-800',
    ochre: 'bg-ochre-100 dark:bg-ochre-900/30 text-ochre-700 dark:text-ochre-300 border-ochre-200 dark:border-ochre-800',
    terracotta: 'bg-terracotta-100 dark:bg-terracotta-900/30 text-terracotta-700 dark:text-terracotta-300 border-terracotta-200 dark:border-terracotta-800',
    'slate-river': 'bg-slate-river-50 dark:bg-slate-river-900/30 text-slate-river-700 dark:text-slate-river-300 border-slate-river-200 dark:border-slate-river-800',
    neutral: 'bg-neutral-100 dark:bg-neutral-900/30 text-neutral-700 dark:text-neutral-300 border-neutral-200 dark:border-neutral-800',
    amber: 'bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800',
    cyan: 'bg-cyan-100 dark:bg-cyan-900/30 text-cyan-700 dark:text-cyan-300 border-cyan-200 dark:border-cyan-800',
  };

  const selectedStyles = colorMap[color] || colorMap.neutral;
  const cursorStyles = onClick ? 'cursor-pointer hover:brightness-95 active:scale-95' : '';

  return (
    <span
      className={`
        inline-flex items-center px-2 py-1 rounded-lg text-xs font-bold border transition-all select-none
        ${selectedStyles} ${cursorStyles} ${className}
      `}
      onClick={onClick}
    >
      {children}
    </span>
  );
};
