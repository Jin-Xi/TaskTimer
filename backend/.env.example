# ChronoFlow Backend Environment Variables
# Copy this file to .env and update the values

# ============ Application Configuration ============
APP_NAME=ChronoFlow
DEBUG=false

# Secret key for JWT (generate with: openssl rand -hex 32)
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ Database Configuration ============
# MySQL connection string
DATABASE_URL=mysql+pymysql://chronoflow:chronoflow_password@localhost:3306/chronoflow

# ============ CORS Configuration ============
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ============ AI Service Configuration (Cloud Mode) ============
# AI provider: deepseek / openai / google
AI_PROVIDER=deepseek

# AI API Key (required for cloud mode)
AI_API_KEY=your-api-key-here

# Model to use
AI_MODEL=deepseek-chat

# Optional: Custom API endpoint
# AI_BASE_URL=https://api.deepseek.com

# ============ Fallback AI Provider (Optional) ============
# If primary provider fails, use this one
# AI_FALLBACK_PROVIDER=openai
# AI_FALLBACK_API_KEY=your-fallback-api-key
# AI_FALLBACK_MODEL=gpt-4o-mini
